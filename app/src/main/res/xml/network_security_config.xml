<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS everywhere (model downloads, links). Plain http only to the Nitro llama-server on the home LAN
     and to localhost, for the Ask path. No API key is involved. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.1.18</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
